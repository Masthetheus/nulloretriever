# -*- encoding: utf-8 -*-
import os

configfile: "workflow/config/config.yaml"

K_VALUES = sorted(int(k) for k in config.get("k", []))
ORGANISMS = config.get("organisms", [])
PATHS = config.get("paths", {})
STATISTICS = config.get("statistics", ["composition", "counter", "motifs"])
EXT = config.get("fasta_extension", "")

GENOMES_DIR = PATHS.get("genomes", "workflow/data/genomes/")
RESULTS_PATH = PATHS.get("results", "workflow/results/")
BENCHMARK_DIR = PATHS.get("bench", "workflow/benchmarks/").rstrip("/")
C_SCRIPT_DIR = PATHS.get("c", "workflow/scripts/c/")

# --- padrões de caminho: fonte única da verdade ---
K_DIR   = os.path.join(RESULTS_PATH, "{organism}", "k{k}")
BIT     = os.path.join(K_DIR, "null_bit_format")
CSV     = os.path.join(K_DIR, "nullomer_statistics.csv")
SUMMARY = os.path.join(RESULTS_PATH, "nullomer_statistics_summarized.csv")
BINARY  = os.path.join(C_SCRIPT_DIR, "bin", "kmer_extractor")

rule all:
    input: SUMMARY

rule generate_c_binaries:
    input:
        c_source = os.path.join(C_SCRIPT_DIR, "src")
    output:
        BINARY
    shell:
        "make -C {C_SCRIPT_DIR}"

rule extract_nullomers:
    input:
        bin    = BINARY,
        genome = lambda wc: os.path.join(GENOMES_DIR, f"{wc.organism}{EXT}"),
    output:
        # k enumerado, organism continua wildcard (por isso {{organism}})
        bits = expand(BIT, k=K_VALUES, allow_missing=True),
        csvs = expand(CSV, k=K_VALUES, allow_missing=True),
    params:
        k_list = K_VALUES,
        stats  = STATISTICS,
    benchmark:
        os.path.join(BENCHMARK_DIR, "{organism}", "extract_nullomers.txt")
    threads: 2
    script:
        "scripts/python/nullomer_complete.py"

rule summarize_nullomer_statistics:
    input:
        csvs = expand(CSV, organism=ORGANISMS, k=K_VALUES),
    output:
        SUMMARY
    params:
        organisms=ORGANISMS
    script:
        "scripts/python/nullomer_statistics_summary.py"
